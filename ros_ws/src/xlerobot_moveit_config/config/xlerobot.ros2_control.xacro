<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mock hardware for now; a real XLeRobot (or a simulator) swaps in its own <hardware> plugin here. -->
  <xacro:macro name="xlerobot_ros2_control" params="name initial_positions_file">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}" />

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <xacro:macro name="position_joint" params="joint">
        <joint name="${joint}">
          <command_interface name="position" />
          <state_interface name="position">
            <param name="initial_value">${initial_positions[joint]}</param>
          </state_interface>
          <state_interface name="velocity" />
        </joint>
      </xacro:macro>
      <xacro:position_joint joint="Rotation" />
      <xacro:position_joint joint="Pitch" />
      <xacro:position_joint joint="Elbow" />
      <xacro:position_joint joint="Wrist_Pitch" />
      <xacro:position_joint joint="Wrist_Roll" />
      <xacro:position_joint joint="Jaw" />
      <xacro:position_joint joint="Rotation_2" />
      <xacro:position_joint joint="Pitch_2" />
      <xacro:position_joint joint="Elbow_2" />
      <xacro:position_joint joint="Wrist_Pitch_2" />
      <xacro:position_joint joint="Wrist_Roll_2" />
      <xacro:position_joint joint="Jaw_2" />
      <xacro:position_joint joint="head_pan_joint" />
      <xacro:position_joint joint="head_tilt_joint" />
    </ros2_control>
  </xacro:macro>
</robot>
